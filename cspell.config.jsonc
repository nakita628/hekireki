{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  // The prose of this repository is written in British English (colour, recognised); the names
  // it is full of — Prisma, SQL functions, the ORMs it writes for — live in .cspell/words.txt.
  "language": "en-GB,en",
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "softwareTerms",
    "html",
    "css",
    "bash",
    "sql",
    "python",
    "go",
    "rust",
    "ruby",
    "php",
    "elixir",
    "project-words",
  ],
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./.cspell/words.txt", "addWords": true },
  ],
  "useGitignore": true,
  "ignorePaths": [
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "test/harness",
    "example/generated",
    "sandbox",
    "packages/hekireki/docs/studio-api.md",
    "packages/hekireki/src/studio/server/routes/index.ts",
    "packages/hekireki/src/studio/client/hooks/index.ts",
    "packages/hekireki/src/studio/client/routeTree.gen.ts",
    "packages/hekireki/e2e/__screenshots__",
    "packages/hekireki/e2e/.workspace",
    "packages/hekireki/e2e/.results",
    "**/*.svg",
    "**/*.png",
    "**/*.snap",
    ".cspell/words.txt",
  ],
  "ignoreRegExpList": ["/[0-9a-f]{7,}/g", "Urls", "Base64", "HexValues"],
}
