{
  "name": "hekireki-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deps": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "check": "vp fmt --check && vp run -r check",
    "fix": "vp fmt && vp run -r check --fix",
    "test": "vp run --filter ./packages/hekireki test",
    "lang": "vp run hekireki#build && vp run --filter ./test test",
    "example": "vp run hekireki#build && vp run --filter ./example generate"
  },
  "dependencies": {
    "hekireki": "link:packages/hekireki"
  },
  "devDependencies": {
    "vite-plus": "0.3.0"
  },
  "packageManager": "pnpm@11.24.0"
}
