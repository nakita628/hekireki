{
  "name": "@hekireki/example-drizzle-mysql",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma validate && prisma generate",
    "db": "prisma db push --url ${DRIZZLE_DATABASE:-mysql://root:root@localhost:3306/drizzle_dates}",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "TZ=UTC node check.ts && TZ=Asia/Tokyo node check.ts",
    "demo": "pnpm run generate && pnpm run db && pnpm run typecheck && pnpm run verify"
  },
  "devDependencies": {
    "@prisma/adapter-mariadb": "8.1.0-dev.7",
    "@prisma/client": "8.1.0-dev.7",
    "@types/node": "^26.6.2",
    "drizzle-orm": "^0.45.3",
    "hekireki": "workspace:*",
    "mysql2": "^3.24.4",
    "prisma": "8.1.0-dev.7",
    "typescript": "^7.0.2"
  }
}
