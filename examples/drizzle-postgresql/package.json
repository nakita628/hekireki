{
  "name": "@hekireki/example-drizzle-postgresql",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma validate && prisma generate",
    "db": "prisma db push --url ${DRIZZLE_DATABASE:-postgresql://postgres:postgres@localhost:5432/drizzle_dates}",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "TZ=UTC node check.ts && TZ=Asia/Tokyo node check.ts",
    "demo": "pnpm run generate && pnpm run db && pnpm run typecheck && pnpm run verify"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "8.1.0-dev.7",
    "@prisma/client": "8.1.0-dev.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.3",
    "hekireki": "workspace:*",
    "pg": "^8.23.0",
    "prisma": "8.1.0-dev.7",
    "typescript": "^7.0.2"
  }
}
