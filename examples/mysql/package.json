{
  "name": "@hekireki/example-mysql",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "prisma validate && prisma generate && prisma db push --url mysql://root:root@localhost:3306/seed",
    "seed": "hekireki seed --reset",
    "seed:sql": "hekireki seed --sql seed.sql",
    "studio": "hekireki studio --schema schema.prisma"
  },
  "devDependencies": {
    "hekireki": "workspace:*",
    "prisma": "8.1.0-dev.6"
  }
}
