{
  "name": "@hekireki/example-sqlalchemy",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf app dev.db dev.db-journal",
    "generate": "prisma validate && prisma generate",
    "db": "prisma db push --url file:./dev.db",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt",
    "typecheck": ".venv/bin/python -m mypy",
    "verify": ".venv/bin/python check.py",
    "demo": "pnpm run clean && pnpm run generate && pnpm run db && pnpm run setup && pnpm run typecheck && pnpm run verify"
  },
  "devDependencies": {
    "hekireki": "workspace:*",
    "prisma": "8.1.0-dev.7"
  }
}
