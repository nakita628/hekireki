
datasource db {
  provider = "mysql"
}

generator client {
  provider            = "prisma-client"
  output              = "generated/client"
  importFileExtension = "ts"
}

generator Hekireki-ER {
  provider = "hekireki-er"
  outputs  = ["er.png"]
}

generator Hekireki-Drizzle {
  provider = "hekireki-drizzle"
  output   = "schema.ts"
}

model User {
  id                     String                  @id
  name                   String                  @db.Text
  email                  String
  emailVerified          Boolean                 @default(false)
  image                  String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  username               String?
  displayUsername        String?                 @db.Text
  isAnonymous            Boolean?                @default(false)
  phoneNumber            String?
  phoneNumberVerified    Boolean?
  twoFactorEnabled       Boolean?                @default(false)
  role                   String?                 @db.Text
  banned                 Boolean?                @default(false)
  banReason              String?                 @db.Text
  banExpires             DateTime?
  lastLoginMethod        String?                 @db.Text
  stripeCustomerId       String?                 @db.Text
  sessions               Session[]
  accounts               Account[]
  twofactors             TwoFactor[]
  passkeys               Passkey[]
  teammembers            TeamMember[]
  members                Member[]
  invitations            Invitation[]
  oauthclients           OauthClient[]
  oauthrefreshtokens     OauthRefreshToken[]
  oauthaccesstokens      OauthAccessToken[]
  oauthconsents          OauthConsent[]
  ssoproviders           SsoProvider[]
  scimidentitytombstones ScimIdentityTombstone[]
  scimsubject            ScimSubject?
  scimusers              ScimUser[]
  scimprojectiongrants   ScimProjectionGrant[]
  walletaddresss         WalletAddress[]

  @@unique([email])
  @@unique([username])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id                   String              @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ipAddress            String?             @db.Text
  userAgent            String?             @db.Text
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?             @db.Text
  activeOrganizationId String?             @db.Text
  activeTeamId         String?             @db.Text
  oauthrefreshtokens   OauthRefreshToken[]
  oauthaccesstokens    OauthAccessToken[]

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret(length: 191)])
  @@index([userId(length: 191)])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId(length: 191)])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}

model Apikey {
  id                  String    @id
  configId            String    @db.Text
  name                String?   @db.Text
  start               String?   @db.Text
  referenceId         String    @db.Text
  prefix              String?   @db.Text
  key                 String    @db.Text
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?   @db.Text
  metadata            String?   @db.Text

  @@index([configId(length: 191)])
  @@index([referenceId(length: 191)])
  @@index([key(length: 191)])
  @@map("apikey")
}

model Organization {
  id                String             @id
  name              String             @db.Text
  slug              String
  logo              String?            @db.Text
  createdAt         DateTime
  metadata          String?            @db.Text
  organizationroles OrganizationRole[]
  teams             Team[]
  members           Member[]
  invitations       Invitation[]

  @@unique([slug])
  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  permission     String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId(length: 191)])
  @@index([role(length: 191)])
  @@map("organizationRole")
}

model Team {
  id             String       @id
  name           String       @db.Text
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId(length: 191)])
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@index([teamId(length: 191)])
  @@index([userId(length: 191)])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime

  @@index([organizationId(length: 191)])
  @@index([userId(length: 191)])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  teamId         String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId(length: 191)])
  @@index([email(length: 191)])
  @@map("invitation")
}

model Jwks {
  id         String    @id
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?   @db.Text
  crv        String?   @db.Text

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?               @db.Text
  clientDiscoveryId                String?               @db.Text
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?               @db.Text
  scopes                           String?
  clientCredentialsScopes          String?               @default("[]")
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?               @db.Text
  uri                              String?               @db.Text
  icon                             String?               @db.Text
  contacts                         String?
  tos                              String?               @db.Text
  policy                           String?               @db.Text
  softwareId                       String?               @db.Text
  softwareVersion                  String?               @db.Text
  softwareStatement                String?               @db.Text
  redirectUris                     String
  postLogoutRedirectUris           String?
  backchannelLogoutUri             String?               @db.Text
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?               @db.Text
  applicationType                  String?               @db.Text
  jwks                             String?               @db.Text
  jwksUri                          String?               @db.Text
  grantTypes                       String?
  responseTypes                    String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?               @db.Text
  metadata                         String?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId(length: 191)])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String                @db.Text
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?               @db.Text
  signingKeyId                  String?               @db.Text
  allowedScopes                 String?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      String?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String        @db.VarChar(191)
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String        @db.VarChar(191)
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      String?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId(length: 191)])
  @@index([resourceId(length: 191)])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @db.Text
  authorizationCodeId     String?            @db.Text
  resources               String?
  requestedUserInfoClaims String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?            @db.Text
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId(length: 191)])
  @@index([sessionId(length: 191)])
  @@index([userId(length: 191)])
  @@index([authorizationCodeId(length: 191)])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @db.Text
  authorizationCodeId     String?            @db.Text
  resources               String?
  requestedUserInfoClaims String?
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            String?
  scopes                  String

  @@unique([token])
  @@index([clientId(length: 191)])
  @@index([sessionId(length: 191)])
  @@index([userId(length: 191)])
  @@index([authorizationCodeId(length: 191)])
  @@index([refreshId(length: 191)])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @db.Text
  resources               String?
  requestedUserInfoClaims String?
  scopes                  String
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId(length: 191)])
  @@index([userId(length: 191)])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

model DeviceCode {
  id              String    @id
  deviceCode      String    @db.VarChar(191)
  userCode        String    @db.VarChar(191)
  userId          String?   @db.Text
  expiresAt       DateTime
  status          String    @db.Text
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?   @db.Text
  scope           String?   @db.Text

  @@unique([deviceCode], map: "deviceCode_deviceCode_uidx")
  @@unique([userCode], map: "deviceCode_userCode_uidx")
  @@map("deviceCode")
}

model SsoProvider {
  id             String  @id
  issuer         String  @db.Text
  oidcConfig     String? @db.Text
  samlConfig     String? @db.Text
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String? @db.Text
  domain         String  @db.Text

  @@unique([providerId])
  @@map("ssoProvider")
}

model ScimManagedConnection {
  id                          String                       @id
  creationRequestId           String
  connectionId                String
  provisioningDomainId        String                       @db.Text
  status                      String                       @db.Text
  revision                    Int
  createdAt                   DateTime
  createdBy                   String                       @db.Text
  decommissionStartedAt       DateTime?
  decommissionStartedBy       String?                      @db.Text
  decommissionedAt            DateTime?
  decommissionedBy            String?                      @db.Text
  scimmanagedcredentials      ScimManagedCredential[]
  scimmanagedconnectionevents ScimManagedConnectionEvent[]

  @@unique([creationRequestId])
  @@unique([connectionId])
  @@index([provisioningDomainId(length: 191)])
  @@map("scimManagedConnection")
}

model ScimManagedCredential {
  id                    String                @id
  connectionRecordId    String
  scimmanagedconnection ScimManagedConnection @relation(fields: [connectionRecordId], references: [id], onDelete: Cascade)
  credentialId          String
  tokenDigest           String                @db.Text
  hashVersion           String                @db.Text
  activeSlotKey         String
  status                String                @db.Text
  serializedScopes      String                @db.Text
  expiresAt             DateTime
  createdAt             DateTime
  createdBy             String                @db.Text
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  revokedBy             String?               @db.Text
  decommissionedAt      DateTime?

  @@unique([credentialId])
  @@unique([activeSlotKey])
  @@index([connectionRecordId(length: 191)])
  @@map("scimManagedCredential")
}

model ScimManagedConnectionEvent {
  id                    String                @id
  connectionRecordId    String
  scimmanagedconnection ScimManagedConnection @relation(fields: [connectionRecordId], references: [id], onDelete: Cascade)
  eventKey              String
  sequence              Int
  type                  String                @db.Text
  actorId               String                @db.Text
  credentialId          String?               @db.Text
  createdAt             DateTime

  @@unique([eventKey])
  @@index([connectionRecordId(length: 191)])
  @@map("scimManagedConnectionEvent")
}

model ScimConnectionBinding {
  id                              String    @id
  connectionId                    String    @db.Text
  connectionKey                   String
  provisioningDomainId            String    @db.Text
  createdAt                       DateTime
  decommissionedAt                DateTime?
  decommissionStatus              String    @db.Text
  decommissionCursorUserId        String?   @db.Text
  decommissionReconciledUserCount Int       @default(0)
  decommissionBatchCount          Int       @default(0)
  decommissionRevision            Int       @default(0)
  decommissionCompletedAt         DateTime?
  decommissionLeaseId             String?   @db.Text
  decommissionLeaseExpiresAt      DateTime?

  @@unique([connectionKey])
  @@index([connectionId(length: 191)])
  @@map("scimConnectionBinding")
}

model ScimIdentityTombstone {
  id                   String   @id
  connectionId         String   @db.Text
  provisioningDomainId String   @db.Text
  externalId           String   @db.Text
  externalIdKey        String
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile              String   @db.Text
  deletedAt            DateTime

  @@unique([externalIdKey])
  @@index([connectionId(length: 191)])
  @@index([provisioningDomainId(length: 191)])
  @@index([userId(length: 191)])
  @@map("scimIdentityTombstone")
}

model ScimSubject {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileSourceId String?  @db.Text
  revision        Int
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([userId])
  @@index([profileSourceId(length: 191)])
  @@map("scimSubject")
}

model ScimUser {
  id                   String                @id
  connectionId         String                @db.Text
  provisioningDomainId String                @db.Text
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionUserKey    String
  userName             String                @db.Text
  userNameKey          String
  primaryEmail         String                @db.Text
  workEmailValueIndex  String                @db.Text
  emailValueIndex      String                @db.Text
  displayName          String                @db.Text
  formattedName        String                @db.Text
  givenName            String?               @db.Text
  familyName           String?               @db.Text
  serializedEmails     String                @db.Text
  serializedAttributes String?               @db.Text
  externalId           String?               @db.Text
  externalIdKey        String?
  active               Boolean
  orderKey             String
  createdAt            DateTime
  updatedAt            DateTime
  scimprojectiongrants ScimProjectionGrant[]
  scimgroupmembers     ScimGroupMember[]

  @@unique([connectionUserKey])
  @@unique([userNameKey])
  @@unique([externalIdKey])
  @@unique([orderKey])
  @@index([connectionId(length: 191)])
  @@index([provisioningDomainId(length: 191)])
  @@index([userId(length: 191)])
  @@map("scimUser")
}

model ScimProjectionGrant {
  id                   String   @id
  connectionId         String   @db.Text
  provisioningDomainId String   @db.Text
  scimUserId           String
  scimuser             ScimUser @relation(fields: [scimUserId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKind           String   @db.Text
  sourceId             String   @db.Text
  sourceValue          String?  @db.Text
  role                 String   @db.Text
  grantKey             String
  createdAt            DateTime
  updatedAt            DateTime

  @@unique([grantKey])
  @@index([connectionId(length: 191)])
  @@index([provisioningDomainId(length: 191)])
  @@index([scimUserId(length: 191)])
  @@index([userId(length: 191)])
  @@map("scimProjectionGrant")
}

model ScimGroup {
  id                   String            @id
  connectionId         String            @db.Text
  provisioningDomainId String            @db.Text
  revision             Int               @default(0)
  displayName          String            @db.Text
  displayNameKey       String
  externalId           String?           @db.Text
  externalIdKey        String?
  orderKey             String
  createdAt            DateTime
  updatedAt            DateTime
  scimgroupmembers     ScimGroupMember[]

  @@unique([displayNameKey])
  @@unique([externalIdKey])
  @@unique([orderKey])
  @@index([connectionId(length: 191)])
  @@index([provisioningDomainId(length: 191)])
  @@map("scimGroup")
}

model ScimGroupMember {
  id            String    @id
  connectionId  String    @db.Text
  groupId       String
  scimgroup     ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scimUserId    String
  scimuser      ScimUser  @relation(fields: [scimUserId], references: [id], onDelete: Cascade)
  membershipKey String
  createdAt     DateTime

  @@unique([membershipKey])
  @@index([connectionId(length: 191)])
  @@index([groupId(length: 191)])
  @@index([scimUserId(length: 191)])
  @@map("scimGroupMember")
}

model WalletAddress {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   @db.Text
  chainId   Int
  isPrimary Boolean  @default(false)
  createdAt DateTime

  @@index([userId(length: 191)])
  @@map("walletAddress")
}

model Subscription {
  id                   String    @id
  plan                 String    @db.Text
  referenceId          String    @db.Text
  stripeCustomerId     String?   @db.Text
  stripeSubscriptionId String?   @db.Text
  status               String    @db.Text
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?   @db.Text
  stripeScheduleId     String?   @db.Text

  @@map("subscription")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
