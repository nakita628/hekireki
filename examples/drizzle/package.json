{
  "name": "@hekireki/example-drizzle",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dev.db dev.db-journal .provider",
    "generate": "prisma validate && prisma generate",
    "db": "prisma db push --url file:./dev.db",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node zones.ts check.ts",
    "demo": "pnpm run clean && pnpm run generate && pnpm run db && pnpm run typecheck && pnpm run verify",
    "demo:postgresql": "node provider.ts postgresql",
    "demo:mysql": "node provider.ts mysql"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "8.1.0-dev.9",
    "@prisma/adapter-mariadb": "8.1.0-dev.9",
    "@prisma/adapter-pg": "8.1.0-dev.9",
    "@prisma/client": "8.1.0-dev.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hekireki": "workspace:*",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prisma": "8.1.0-dev.9",
    "typescript": "^7.0.2"
  }
}
