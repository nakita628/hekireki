// The schema the database-backed seed check runs against a real PostgreSQL (test/db/seed.test.ts, through the hekireki.config.ts beside it):
// every relation shape hekireki seed has to get right, plus PostgreSQL scalar lists.

datasource db {
  provider = "postgresql"
}

// The Prisma Client `hekireki seed` writes through; generated by the test before it runs, with
// the driver adapter of the dialect coming from the repository's devDependencies.
generator client {
  provider = "prisma-client"
  output   = "generated/client"
}

// The schema module hekireki.config.ts is typed against; regenerated by the test before it runs.
generator Hekireki-Seed {
  provider = "hekireki-seed"
  output   = "generated/seed"
}

enum Visibility {
  PUBLIC    @map("public")
  PRIVATE   @map("private")
  LINK_ONLY @map("link_only")
}

model User {
  id        String    @id @default(uuid(7))
  email     String    @unique
  name      String
  interests String[]  @default([])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  profile   Profile?
  posts     Post[]
  comments  Comment[]
  followers Follow[]  @relation("following")
  following Follow[]  @relation("follower")

  @@map("users")
}

model Profile {
  id      String  @id @default(cuid(2))
  userId  String  @unique @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio     String?
  balance Decimal @default(0) @db.Decimal(10, 2)
  meta    Json?
  avatar  Bytes?
}

model Post {
  id         Int        @id @default(autoincrement())
  title      String
  visibility Visibility @default(PUBLIC)
  published  Boolean    @default(false)
  authorId   String     @map("author_id")
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags       Tag[]
  comments   Comment[]
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("posts")
}

model Tag {
  id    Int    @id @default(autoincrement())
  label String @unique
  posts Post[]
}

model Comment {
  id       BigInt  @id @default(autoincrement())
  body     String
  postId   Int     @map("post_id")
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("comments")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  since       DateTime @default(now())

  @@id([followerId, followingId])
  @@map("follows")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")

  @@unique([parentId, name])
}
