// Complex example schema exercising every hekireki generator at once.
// Run `pnpm example` from the repository root, then inspect example/generated/.

datasource db {
  provider = "postgresql"
}

generator Hekireki-Zod {
  provider = "hekireki-zod"
  output   = "generated/zod"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-Valibot {
  provider = "hekireki-valibot"
  output   = "generated/valibot"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-ArkType {
  provider = "hekireki-arktype"
  output   = "generated/arktype"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-Effect {
  provider = "hekireki-effect"
  output   = "generated/effect"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-TypeBox {
  provider = "hekireki-typebox"
  output   = "generated/typebox"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-AJV {
  provider = "hekireki-ajv"
  output   = "generated/ajv"
  type     = true
  comment  = true
  relation = true
}

generator Hekireki-Drizzle {
  provider = "hekireki-drizzle"
  output   = "generated/drizzle/schema.ts"
}

generator Hekireki-Kysely {
  provider = "hekireki-kysely"
  output   = "generated/kysely/types.ts"
}

generator Hekireki-SQLAlchemy {
