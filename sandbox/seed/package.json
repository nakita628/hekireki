{
  "name": "@hekireki/sandbox-seed",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "prisma validate && prisma generate && prisma db push --url file:./seed.db",
    "seed": "hekireki seed --url file:./seed.db --reset",
    "seed:sql": "hekireki seed --sql seed.sql",
    "studio": "hekireki studio --schema schema.prisma --url file:./seed.db",
    "reset": "rm -f seed.db && pnpm setup",
    "seed:data": "hekireki seed --config hekireki.data.config.ts --url file:./seed.db --reset"
  },
  "devDependencies": {
    "hekireki": "workspace:*",
    "prisma": "8.1.0-dev.6"
  }
}
