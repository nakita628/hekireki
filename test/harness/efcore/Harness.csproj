<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the C# Hekireki-EFCore writes for test/prisma/schema.prisma (Models/) and
    test/prisma/efcore.prisma (Edge/) against the real EF Core and Npgsql, with every warning an
    error, and runs the checks in Program.cs. The generated directories are regenerated by
    test/lang/setup.ts and gitignored.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- ulid() and cuid() / cuid(2) defaults are generated with these. -->
    <PackageReference Include="Ulid" Version="1.4.1" />
    <PackageReference Include="cuid.net" Version="7.0.0" />
  </ItemGroup>

</Project>
