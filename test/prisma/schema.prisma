datasource db {
  provider = "postgresql"
}

generator Hekireki-GORM {
  provider = "hekireki-gorm"
  output   = "../harness/gorm/model"
}

generator Hekireki-SeaORM {
  provider = "hekireki-sea-orm"
  output   = "../harness/sea-orm/src/entities"
}

generator Hekireki-SQLAlchemy {
  provider = "hekireki-sqlalchemy"
  output   = "../harness/sqlalchemy"
}

generator Hekireki-Pydantic {
  provider = "hekireki-pydantic"
  output   = "../harness/pydantic"
  relation = true
}

generator Hekireki-Ecto {
  provider = "hekireki-ecto"
  output   = "../harness/ecto/lib"
  app      = "DBSchema"
}

generator Hekireki-Django {
  provider = "hekireki-django"
  output   = "../harness/django/app"
}

generator Hekireki-Drizzle {
  provider = "hekireki-drizzle"
  output   = "../harness/drizzle/schema.ts"
}

generator Hekireki-Kysely {
  provider = "hekireki-kysely"
  output   = "../harness/kysely/types.ts"
}

generator Hekireki-ActiveRecord {
  provider = "hekireki-activerecord"
  output   = "../harness/activerecord/models"
  locales  = "../config/locales"
}

generator Hekireki-Eloquent {
  provider = "hekireki-eloquent"
  output   = "../harness/eloquent/models"
}

generator Hekireki-Atlas {
  provider = "hekireki-atlas"
  output   = "../harness/atlas/schema.hcl"
}

generator Hekireki-EFCore {
  provider = "hekireki-efcore"
  output   = "../harness/efcore/Models"
}

generator Hekireki-Exposed {
  provider = "hekireki-exposed"
  output   = "../harness/exposed/src/main/kotlin/models"
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING_REVIEW
}

// Enum with @map on every value and @@map on the enum itself: the database
// stores the mapped values ("link_only"), while DMMF hands generators the
// Prisma-level names ("LINK_ONLY") — including in @default.
enum Visibility {
  PUBLIC    @map("public")
  PRIVATE   @map("private")
  LINK_ONLY @map("link_only")

  @@map("visibility_level")
}

// Every scalar type + enum default + scalar list (array) + @map/@@map +
// two relations to the same model (follower/following).
model Account {
  id        String   @id @default(uuid())
  bigNum    BigInt
  price     Decimal
  data      Json
  raw       Bytes
  ratio     Float
  flag      Boolean
  count     Int
  createdAt DateTime @default(now()) @map("created_at")
  status    Status   @default(ACTIVE)
  tags      String[]
  posts     Post[]
  profile   Profile?
  followers Follow[] @relation("following")
  following Follow[] @relation("follower")

  @@map("accounts")
}

// One-to-one relation + cuid PK + optional scalars/enum + native @db.* types +
// literal defaults + @updatedAt + composite @@unique + @@index. Its Ecto changeset
// casts them all, and names the unique keys and the foreign key as Prisma does.
/// @ecto
model Profile {
  id        String    @id @default(cuid())
  accountId String    @unique
  account   Account   @relation(fields: [accountId], references: [id])
  bio       String?   @db.Text
  nickname  String    @default("anonymous") @db.VarChar(64)
  age       Int?      @db.SmallInt
  score     Float     @default(0)
  balance   Decimal   @default(0) @db.Decimal(10, 2)
  verified  Boolean   @default(false)
  mood      Status?
  meta      Json?
  avatar    Bytes?
  lastSeen  DateTime? @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([nickname, accountId])
  @@index([age])
}

// Self-relation (adjacency-list tree): parent must be a pointer/remote_side.
model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")
}

// Self-relation with the list end declared before the foreign key: the list's other end is
// `manager`, not the list itself, so there is no implicit join table.
model Employee {
  id        Int        @id @default(autoincrement())
  reports   Employee[] @relation("management")
  managerId Int?
  manager   Employee?  @relation("management", fields: [managerId], references: [id])
}

// Implicit self many-to-many: `_mentorship` holds both ends' keys. `A` is the key of the row
// whose field sorts first (`mentees`), so each end reads the table in the other direction.
model Mentor {
  id      Int      @id @default(autoincrement())
  mentors Mentor[] @relation("mentorship")
  mentees Mentor[] @relation("mentorship")
}

// Implicit many-to-many between models whose keys are not `id`: the join table's foreign keys
// reference `paperId` and `slug`.
model Paper {
  paperId Int      @id @default(autoincrement())
  topics  Topic[]
}

model Topic {
  slug   String  @id
  papers Paper[]
}

// One relation name between two pairs of models: `Pupil.crests` is the end of `Crest.pupil`, not
// of `Crest.guild`, though both are called "holder".
model Pupil {
  id     Int     @id @default(autoincrement())
  crests Crest[] @relation("holder")
}

model Guild {
  id     Int     @id @default(autoincrement())
  crests Crest[] @relation("holder")
}

model Crest {
  id      Int   @id @default(autoincrement())
  guildId Int
  guild   Guild @relation("holder", fields: [guildId], references: [id])
  pupilId Int
  pupil   Pupil @relation("holder", fields: [pupilId], references: [id])
}

// Composite PK + two foreign keys to the same model.
model Follow {
  followerId  String
  followingId String
  follower    Account @relation("follower", fields: [followerId], references: [id])
  following   Account @relation("following", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

// Implicit many-to-many (Prisma _PostToTag join table).
model Post {
  id       String @id @default(uuid())
  title    String
  authorId String
  author   Account @relation(fields: [authorId], references: [id])
  tags     Tag[]
}

model Tag {
  id    String @id @default(uuid())
  label String @unique
  posts Post[]
}

// UUIDv7 primary key: every ORM must emit version-aware client-side
// generation (uuid(7) is silently distinct from uuid() in DMMF args).
model Event {
  /// @p.UUID7
  id      String   @id @default(uuid(7))
  name    String
  happens DateTime
}

// ULID primary key: client-side ULID generation in every ORM
// (ulidx / python-ulid / oklog/ulid / ulid crate / Ecto.ULID / ulid gem /
// HasUlids), and a ULID that is not the key, made the same way. Timestamps
// under Prisma's own names, unmapped: @updatedAt is set by the client, so an
// ORM whose timestamp convention is created_at / updated_at (Active Record,
// Eloquent) must point it at these columns.
model Ticket {
  id        String   @id @default(ulid())
  code      String   @default(ulid())
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Field names that are reserved words in Rust (type/match/self) and Python
// (async/yield); the generators must escape or rename them. These are not
// Elixir keywords, so Ecto is unaffected.
model Keyword {
  id    String @id @default(uuid())
  type  String
  match String
  async String
  yield String
  self  String
}

// Literal defaults at their extremes: negatives, BigInt beyond
// Number.MAX_SAFE_INTEGER, DateTime ISO literal, Json object/array/scalar,
// and string escaping (quote, backslash, unicode, empty). Float/Decimal stay
// within exact double representation: Prisma's DMMF parses both into a JS
// number, so -273.15 or a 30-digit Decimal reach the generators pre-mangled.
model Torture {
  id       Int      @id @default(autoincrement())
  negInt   Int      @default(-42)
  negFloat Float    @default(-2.5)
  bigPos   BigInt   @default(9007199254740993)
  bigNeg   BigInt   @default(-9007199254740993)
  precise  Decimal  @default("12345.6789")
  born     DateTime @default("2020-02-29T23:59:59.999Z")
  jsonObj  Json     @default("{\"a\":1,\"b\":[true,null,\"x\"]}")
  jsonArr  Json     @default("[]")
  jsonStr  Json     @default("\"quoted\"")
  quoted   String   @default("it's a \"quote\" and a \\ backslash")
  unicode  String   @default("日本語と🔥絵文字")
  empty    String   @default("")
  zero     Int      @default(0)
  offFlag  Boolean  @default(false)
}

// PostgreSQL native-type breadth: every @db.* attribute Prisma accepts for
// these scalars must survive each generator (correct mapped type or a safe
// fallback — never invalid output).
model NativeGrid {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @db.Char(3)
  label    String   @db.VarChar(32)
  tiny     Int      @db.SmallInt
  ordinary Int      @db.Integer
  ident    Int      @db.Oid
  single   Float    @db.Real
  double   Float    @db.DoublePrecision
  wealth   Decimal  @db.Money
  exact    Decimal  @db.Decimal(38, 12)
  blobby   Bytes    @db.ByteA
  doc      Json     @db.JsonB
  plain    Json     @db.Json
  day      DateTime @db.Date
  clock    DateTime @db.Time(3)
  stamp    DateTime @db.Timestamp(0)
  zoned    DateTime @db.Timestamptz(6)
  address  String   @db.Inet
  mask     String   @db.Bit(8)
  varMask  String   @db.VarBit(16)
  markup   String   @db.Xml
  bigCount BigInt   @db.BigInt
  flagged  Boolean  @db.Boolean
}

// BigInt autoincrement PK (bigserial): must surface as i64 / int64 / BIGINT
// identity, not a string or i32.
model Sequence {
  id   BigInt @id @default(autoincrement())
  name String
}

// snake_case model name: class/struct/module identifiers must be
// PascalCased per language convention while the table name stays verbatim
// (Ruby/Elixir reject lowercase class and module names outright).
model order_line_item {
  id       Int    @id @default(autoincrement())
  sku_code String
  qty      Int    @default(1)
}

// Every referential action Prisma accepts, five FKs to the same parent:
// stresses both the action mapping and belongs-to disambiguation when one
// model is referenced many times. Ecto's changesets name the five keys, and refuse the
// delete of a parent the Restrict and NoAction children keep.
/// @ecto
model RefActionParent {
  id        Int              @id @default(autoincrement())
  cascades  RefActionChild[] @relation("cascade")
  nulls     RefActionChild[] @relation("setnull")
  restricts RefActionChild[] @relation("restrict")
  noacts    RefActionChild[] @relation("noaction")
  defaults  RefActionChild[] @relation("setdefault")
}

/// @ecto
model RefActionChild {
  id           Int              @id @default(autoincrement())
  cascadeId    Int
  cascade      RefActionParent  @relation("cascade", fields: [cascadeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  setNullId    Int?
  setNull      RefActionParent? @relation("setnull", fields: [setNullId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  restrictId   Int
  restrict     RefActionParent  @relation("restrict", fields: [restrictId], references: [id], onDelete: Restrict)
  noActionId   Int
  noAction     RefActionParent  @relation("noaction", fields: [noActionId], references: [id], onDelete: NoAction)
  setDefaultId Int              @default(1)
  setDefault   RefActionParent  @relation("setdefault", fields: [setDefaultId], references: [id], onDelete: SetDefault)
}

// FK referencing a non-id unique column (references: [slug], not the PK). Its Ecto
// changeset keeps "" as sent, and counts only nil as missing.
/// @ecto.cast(empty_values: [])
model Handle {
  id     Int     @id @default(autoincrement())
  slug   String  @unique
  claims Claim[]
}

model Claim {
  id     Int    @id @default(autoincrement())
  slug   String
  handle Handle @relation(fields: [slug], references: [slug], onDelete: Cascade)
}

// One-to-one self-relation: the FK side must be optional and unique, and the
// ORM must distinguish the two sides of the same named relation.
model Monarch {
  id          Int      @id @default(autoincrement())
  name        String
  successorId Int?     @unique
  successor   Monarch? @relation("succession", fields: [successorId], references: [id])
  predecessor Monarch? @relation("succession")
}

// Named implicit many-to-many: the join table is `_cast` (relation name),
// not `_ActorToFilm`.
model Actor {
  id    Int    @id @default(autoincrement())
  films Film[] @relation("cast")
}

model Film {
  id     Int     @id @default(autoincrement())
  actors Actor[] @relation("cast")
}

// Composite FK: two columns referencing a composite @@unique that is not the
// PK. ORMs with composite-FK support must join on both columns; ORMs without
// it (Eloquent, Ecto) must fall back safely instead of emitting a half-join.
/// @ecto
model Warehouse {
  id      Int     @id @default(autoincrement())
  country String
  code    String
  stocks  Stock[]

  @@unique([country, code])
}

/// @ecto
model Stock {
  id        Int       @id @default(autoincrement())
  country   String
  code      String
  amount    Int
  /// @ecto.assoc_constraint(message: "no such warehouse")
  warehouse Warehouse @relation(fields: [country, code], references: [country, code], onDelete: Cascade)
}

// FK whose target is a composite-PK model (both columns of @@id).
/// @ecto
model GridCell {
  x     Int
  y     Int
  marks Mark[]

  @@id([x, y])
}

model Mark {
  id   Int      @id @default(autoincrement())
  x    Int
  y    Int
  cell GridCell @relation(fields: [x, y], references: [x, y])
}

// Mapped enum in every position: required with a mapped default, optional,
// and as a PostgreSQL enum array.
model Board {
  id         Int          @id @default(autoincrement())
  visibility Visibility   @default(LINK_ONLY)
  fallback   Visibility?
  audiences  Visibility[]
}

// Scalar list defaults (empty and populated) plus a list of every scalar
// type — generators without a native list representation must still emit
// valid code.
model Inventory {
  id      Int       @id @default(autoincrement())
  tags    String[]  @default([])
  codes   Int[]     @default([1, 2, 3])
  labels  String[]  @default(["a", "b"])
  weights Float[]
  flags   Boolean[]
  stamps  DateTime[]
  bigs    BigInt[]
  decs    Decimal[]
}

// dbgenerated() defaults: DB-side expressions that no client library can
// evaluate — emit as a raw DDL default or skip, never as a string literal.
model Computed {
  id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  when DateTime @default(dbgenerated("now() + interval '1 day'"))
  code String   @default(dbgenerated("md5(random()::text)"))
}

// @ignore field and @@ignore model: both are absent from DMMF, so no
// generator may emit them (Ghost keeps id/seen only; Phantom vanishes).
model Ghost {
  id     Int    @id @default(autoincrement())
  seen   String
  hidden String @ignore

  // An index or unique over an @ignore field names a column that is not there.
  @@unique([seen, hidden])
  @@index([hidden])
}

model Phantom {
  id Int @id @default(autoincrement())

  @@ignore
}

// cuid(2) and nanoid(10) primary keys: client-side generation where the ORM
// ecosystem has a library for it, a plain assignable PK otherwise.
model Badge {
  id   String @id @default(cuid(2))
  name String
}

model Coupon {
  id   String @id @default(nanoid(10))
  name String
}

// Pydantic model_config passthrough: @p.ConfigDict(extra='forbid') must
// reject unknown keys, @p.ConfigDict(extra='allow') must keep them, no
// annotation is pydantic's default (extra="ignore"), and the @p. field
// annotation must be used verbatim with its pydantic/typing imports resolved.
/// Payload the client said was "locked"
/// @p.ConfigDict(extra='forbid')
model Locked {
  id   Int    @id @default(autoincrement())
  /// Name whose doc ends with a "quote"
  /// @p.Annotated[str, StringConstraints(min_length=1, max_length=64)]
  name String
}

// Every target writes the prose of these `///` comments. Each line holds what would end or break
// a comment in one of the languages: a block comment's close (and, in Kotlin, a nested open), a
// docstring's quotes and backslash, Elixir's interpolation, XML in C#.
/// A model documented in prose.
///
/// Ends a block */ or opens one /* and a docstring """ with a \ backslash,
/// interpolates #{nothing} and is <b>XML</b> & more"
model Commented {
  id   Int    @id @default(autoincrement())
  /// The body; ends */ /* """ \ #{x} <&> with a quote"
  /// @p.str
  body String
  tone Tone
  /// @p.str
  bare String
}

/// A documented enum */ /* """ \ #{x} <&>"
enum Tone {
  CALM
  LOUD
}

/// @p.ConfigDict(extra='allow')
/// @ar.validates :name, :contact, presence: true, on: :create
/// @ar.normalizes :name, with: ->(name) { name.strip }
/// @ar.name(ja: "公開情報", en: { one: "Open record", other: "Open records" })
model Open {
  id      Int      @id @default(autoincrement())
  /// @ar.name(ja: "名前", en: "Name")
  /// @ecto.validate_length(max: 40, message: "%{count}文字以内で入力してください")
  /// @ar.length(maximum: 40, too_long: { ja: "%{count}文字以内で入力してください", en: { one: "is too long (maximum is 1 character)", other: "is too long (maximum is %{count} characters)" } })
  name    String
  /// @p.EmailStr
  /// @ecto.validate_format(~r/@/, message: "の形式が正しくありません")
  /// @ar.format(with: URI::MailTo::EMAIL_REGEXP, message: { ja: "の形式が正しくありません", en: "is not an email address" })
  contact String
  /// @p.HttpUrl
  site    String
  /// @p.AwareDatetime
  seenAt  DateTime
}

// Names that collide with ORM machinery rather than language keywords:
// SQLAlchemy's DeclarativeBase reserves `metadata`/`registry`; GORM's Tabler
// interface owns `TableName` (a `tableName` column in a @@map model would
// otherwise generate a field and a method with the same name).
model MachineWord {
  id        Int    @id @default(autoincrement())
  metadata  String
  registry  String
  tableName String

  @@map("machine_words")
}

// A model with neither @id nor @@id is keyed by its first unique (Auth.js's
// Session and VerificationToken), and the relations of the other models that
// name it must still load.
model Session {
  sessionToken String   @unique
  memberId     Int
  expires      DateTime
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Two tables joined by a foreign key in each direction (Cal.com's User and
// Profile): SQLAlchemy needs foreign_keys= on every relationship between them,
// Go a pointer for each belongs-to, and drizzle a stated return type for the
// callbacks on the cycle.
model Member {
  id          Int          @id @default(autoincrement())
  movedToId   Int?
  movedTo     Membership?  @relation("moved_to", fields: [movedToId], references: [id])
  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  movedFrom Member[] @relation("moved_to")
}

// Names a module of the generated code already uses: `text` (SQLAlchemy's
// text()), `models` and `timezone` (Django's modules) read later in the class
// body, a model named Base (SQLAlchemy's declarative base) or Monitor (Ruby's
// stdlib class), and an enum named Type (a Rust keyword as a module).
enum Type {
  BUY
  SELL
}

model Note {
  id        Int       @id @default(autoincrement())
  text      String
  timezone  String?
  models    String
  type      Type
  createdAt DateTime? @default(now())
}

model Base {
  id   String @id @default(cuid())
  name String
}

model Monitor {
  id   String @id @default(cuid())
  name String
}

// A one-column @@id is a primary key of one field, and two models whose
// snake_case names differ only by a trailing digit are ordered as rustfmt
// orders them.
model BuilderState {
  builderId String
  updatedAt DateTime

  @@id([builderId])
}

model BuilderState2 {
  builderId String
  updatedAt DateTime

  @@id([builderId])
}

// An implicit many-to-many whose join-table relation chains are wider than
// rustfmt's line.
model BlockVersionSnapshot {
  id        Int                       @id @default(autoincrement())
  resources ResourceVersionSnapshot[]
}

model ResourceVersionSnapshot {
  id     Int                    @id @default(autoincrement())
  blocks BlockVersionSnapshot[]
}

// Associations Active Record already has a method of that name for
// (attributes, errors), and a has_many whose name Rails singularizes to a
// class that does not exist (event_data -> EventDatum, not EventData).
model Contact {
  id         Int                @id @default(autoincrement())
  attributes ContactAttribute[]
  errors     ContactError[]
  event_data EventData[]
}

model ContactAttribute {
  id        Int     @id @default(autoincrement())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])
}

model ContactError {
  id        Int     @id @default(autoincrement())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])
}

model EventData {
  id        Int     @id @default(autoincrement())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])
}

// Two fields that become one name in PascalCase (documenso's Account:
// `createdAt` beside the `created_at` an OAuth provider returns), enum members
// named after a method of str, and an optional relation over a required key
// that the composite primary key holds (typebot's RuntimeMediaIdCache). Two
// indexes over the same columns are left to the unit tests: Exposed's
// MigrationUtils cannot tell them apart in the catalogue.
enum ScriptMode {
  replace
  center
  count
  add
}

model Script {
  id         Int           @id @default(autoincrement())
  createdAt  DateTime      @default(now())
  created_at Int?
  mode       ScriptMode    @default(replace)
  caches     ScriptCache[]
}

model ScriptCache {
  scriptId Int
  key      String
  script   Script? @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@id([scriptId, key])
}

// A composite foreign key that shares a column with another relation
// (OpenLIT's DatabaseConfig): two relationships copy `projectId`.
model Project {
  id           String               @id @default(cuid())
  environments ProjectEnvironment[]
  configs      ProjectConfig[]
}

model ProjectEnvironment {
  projectId String
  name      String
  project   Project         @relation(fields: [projectId], references: [id])
  configs   ProjectConfig[] @relation("EnvironmentConfigs")

  @@id([projectId, name])
}

model ProjectConfig {
  id             String              @id @default(cuid())
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment    String              @default("production")
  environmentRef ProjectEnvironment? @relation("EnvironmentConfigs", fields: [projectId, environment], references: [projectId, name], onDelete: Restrict)
}
