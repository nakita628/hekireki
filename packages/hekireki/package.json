{
  "name": "hekireki",
  "version": "0.20.1",
  "description": "Hekireki is a code generator from Prisma schema to validation schemas, ORM models and ER diagrams, with a Studio for your schema and its data",
  "keywords": [
    "activerecord",
    "ajv",
    "arktype",
    "atlas",
    "dbml",
    "django",
    "docs",
    "documentation",
    "ecto",
    "effect",
    "eloquent",
    "go",
    "gorm",
    "json-schema",
    "kysely",
    "laravel",
    "mermaid",
    "php",
    "prisma",
    "pydantic",
    "python",
    "rails",
    "ruby",
    "rust",
    "sea-orm",
    "typebox",
    "valibot",
    "zod"
  ],
  "homepage": "https://github.com/nakita628/hekireki",
  "bugs": {
    "url": "https://github.com/nakita628/hekireki/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/hekireki.git"
  },
  "bin": {
    "hekireki": "dist/bin/hekireki.js",
    "hekireki-activerecord": "dist/bin/activerecord.js",
    "hekireki-ajv": "dist/bin/ajv.js",
    "hekireki-arktype": "dist/bin/arktype.js",
    "hekireki-atlas": "dist/bin/atlas.js",
    "hekireki-django": "dist/bin/django.js",
    "hekireki-drizzle": "dist/bin/drizzle.js",
    "hekireki-ecto": "dist/bin/ecto.js",
    "hekireki-effect": "dist/bin/effect.js",
    "hekireki-eloquent": "dist/bin/eloquent.js",
    "hekireki-er": "dist/bin/er.js",
    "hekireki-gorm": "dist/bin/gorm.js",
    "hekireki-kysely": "dist/bin/kysely.js",
    "hekireki-pydantic": "dist/bin/pydantic.js",
    "hekireki-sea-orm": "dist/bin/sea-orm.js",
    "hekireki-sqlalchemy": "dist/bin/sqlalchemy.js",
    "hekireki-typebox": "dist/bin/typebox.js",
    "hekireki-valibot": "dist/bin/valibot.js",
    "hekireki-zod": "dist/bin/zod.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && vp build -c vite.studio.config.ts",
    "check": "vp check && tsgo -p src/studio/client/tsconfig.json --noEmit",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "pnpm build && playwright test",
    "studio:dev": "vp dev -c vite.studio.config.ts",
    "deps": "rm -rf node_modules && pnpm install",
    "studio:api": "hono-takibi"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@effect/platform-node": "^4.0.0-rc.112",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-openapi": "^1.6.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/generator-helper": "8.1.0-dev.6",
    "@prisma/get-dmmf": "8.1.0-dev.6",
    "@prisma/language-server": "^31.12.2",
    "@prisma/prisma-schema-wasm": "8.1.0-2.59be4fda12412a79eeb9c2ae727b6aa723593323",
    "@resvg/resvg-js": "^2.6.2",
    "cuid": "^3.0.0",
    "effect": "^4.0.0-rc.112",
    "hono": "^4.12.32",
    "nanoid": "^6.0.0",
    "oxfmt": "^0.64.0",
    "ulidx": "^2.4.1",
    "uuid": "^14.0.1",
    "valibot": "1.4.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@sinclair/typebox": "^0.34.52",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-core": "1.171.27",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@typespec/compiler": "^1.15.0",
    "@typespec/http": "^1.15.0",
    "@typespec/openapi": "^1.15.0",
    "@typespec/openapi3": "^1.15.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.5",
    "arktype": "^2.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono-takibi": "^0.9.99998",
    "json-schema-to-ts": "^3.1.1",
    "kysely": "^0.29.5",
    "monaco-editor": "^0.56.0",
    "oxlint": "1.80.0",
    "prisma": "8.1.0-dev.6",
    "react": "^19.2.8",
