{
  "name": "hekireki",
  "version": "0.32.0",
  "description": "Hekireki is a code generator from Prisma schema to validation schemas, ORM models and ER diagrams, with a Studio for your schema and its data",
  "keywords": [
    "activerecord",
    "ajv",
    "arktype",
    "atlas",
    "csharp",
    "dbml",
    "django",
    "docs",
    "documentation",
    "ecto",
    "efcore",
    "effect",
    "eloquent",
    "entity-framework-core",
    "exposed",
    "faker",
    "go",
    "gorm",
    "json-schema",
    "kotlin",
    "kysely",
    "laravel",
    "mermaid",
    "php",
    "prisma",
    "pydantic",
    "python",
    "rails",
    "ruby",
    "rust",
    "sea-orm",
    "typebox",
    "valibot",
    "zod"
  ],
  "homepage": "https://github.com/nakita628/hekireki",
  "bugs": {
    "url": "https://github.com/nakita628/hekireki/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/hekireki.git"
  },
  "bin": {
    "hekireki": "dist/bin/hekireki.js",
    "hekireki-activerecord": "dist/bin/activerecord.js",
    "hekireki-ajv": "dist/bin/ajv.js",
    "hekireki-arktype": "dist/bin/arktype.js",
    "hekireki-atlas": "dist/bin/atlas.js",
    "hekireki-django": "dist/bin/django.js",
    "hekireki-drizzle": "dist/bin/drizzle.js",
    "hekireki-ecto": "dist/bin/ecto.js",
    "hekireki-efcore": "dist/bin/efcore.js",
    "hekireki-effect": "dist/bin/effect.js",
    "hekireki-eloquent": "dist/bin/eloquent.js",
    "hekireki-er": "dist/bin/er.js",
    "hekireki-exposed": "dist/bin/exposed.js",
    "hekireki-gorm": "dist/bin/gorm.js",
    "hekireki-kysely": "dist/bin/kysely.js",
    "hekireki-pydantic": "dist/bin/pydantic.js",
    "hekireki-sea-orm": "dist/bin/sea-orm.js",
    "hekireki-seed": "dist/bin/seed.js",
    "hekireki-sqlalchemy": "dist/bin/sqlalchemy.js",
    "hekireki-typebox": "dist/bin/typebox.js",
    "hekireki-valibot": "dist/bin/valibot.js",
    "hekireki-zod": "dist/bin/zod.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && vp build -c vite.studio.config.ts",
    "check": "vp check && tsgo -p src/studio/client/tsconfig.json --noEmit",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "pnpm build && playwright test",
    "studio:dev": "vp dev -c vite.studio.config.ts",
    "deps": "rm -rf node_modules && pnpm install",
    "studio:api": "hono-takibi"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@effect/platform-node": "^4.0.0-rc.116",
