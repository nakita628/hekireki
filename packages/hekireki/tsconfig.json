{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    // A case falls through, a method overrides without `override`, a parameter goes unused (name
    // it `_x` to say so), a side-effect import names a file that is not there, a line can never
    // run, a label is never used: each is an error.
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "moduleResolution": "bundler",
    // @prisma/language-server only exports its stdio entry; its request handlers are loaded from
    // dist/lib at runtime (services/language.ts) and typed from the declarations shipped there.
    "paths": {
      "@prisma/language-server/dist/*": ["./node_modules/@prisma/language-server/dist/*"]
    }
  },
  "include": ["**/src/**/*"],
  // The client is checked by its own build; everything else, tests included, is checked here.
  "exclude": ["src/studio/client/**/*"]
}
