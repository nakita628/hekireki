{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "moduleResolution": "bundler"
  },
  "include": ["**/src/**/*"],
  "exclude": ["**/src/**/*.test.ts", "src/studio/client/**/*"]
}
