{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "moduleResolution": "bundler",
    // @prisma/language-server only exports its stdio entry; its request handlers are loaded from
    // dist/lib at runtime (services/language.ts) and typed from the declarations shipped there.
    "paths": {
      "@prisma/language-server/dist/*": ["./node_modules/@prisma/language-server/dist/*"]
    }
  },
  "include": ["**/src/**/*"],
  // The client is checked by its own build; everything else, tests included, is checked here.
  "exclude": ["src/studio/client/**/*"]
}
